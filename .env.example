# Copy to .env and fill
GOOGLE_API_KEY=your_gemini_api_key_here
# Optional: LangSmith tracing (0 RAM, cloud)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=autonomous-ai-engineer

# Optional: GitHub PR creation (after HITL approval)
GITHUB_TOKEN=

# Simple auth for demo (single key, no OAuth)
API_KEY=demo-key-123

# Data paths (file-based, no server)
DATABASE_PATH=./app.db
CHROMA_PATH=./chroma_db
CHECKPOINT_PATH=./checkpoints.db
OUTPUT_PATH=./output
